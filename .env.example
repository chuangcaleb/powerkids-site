# Reference: docs/workflows/environments.md

# ── Database ────────────────────────────────────────────────────────────────
# Neon connection string. Use the *dev branch* locally, never the primary.
# Neon's dashboard offers pooled and direct strings; use pooled for the app.
DATABASE_URI=

# ── Payload ─────────────────────────────────────────────────────────────────
# Signs authentication tokens. Any long random string; unique per environment.
# Rotating it logs every admin user out. Generate one with:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public origin of this environment. Used for absolute URLs and preview
# callbacks. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Media storage (Cloudflare R2) ───────────────────────────────────────────
# R2 is S3-compatible. Create an R2 API token with Object Read & Write.
S3_BUCKET=

# From the R2 API token page. Check the SHAPE of each value — the page also
# shows a "Token value", which is a different string and will fail with
# `SignatureDoesNotMatch`, an error that reads like a typo but is not.
#   Access Key ID      exactly 32 lowercase hex characters
#   Secret Access Key  exactly 64 lowercase hex characters
#   Token value        ~53 mixed alphanumeric  ← NOT what goes here
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Account-level S3 endpoint, used to WRITE objects. No bucket path — the
# bucket is passed separately as S3_BUCKET above.
#   https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=

# Public base URL visitors READ files from. This is NOT the endpoint above:
# that one requires signed requests and would return 401 to visitors.
# Enable it under the bucket's Settings > Public Development URL, or use a
# connected custom domain. No trailing slash.
#   https://pub-<hash>.r2.dev
R2_PUBLIC_URL=

# Note: there is no S3_REGION here on purpose. R2's region is always the
# literal string "auto", so it is hard-coded in src/lib/env.ts rather than
# left as a variable someone can set wrongly.

# ── Email (Resend) ──────────────────────────────────────────────────────────
# API key from Resend dashboard.
RESEND_API_KEY=

# Sender address. Domain must be verified in Resend, else sends fail.
RESEND_FROM_ADDRESS=

# ── Preview ─────────────────────────────────────────────────────────────────
# Guards the draft-preview route (/preview). Any long random string.
PREVIEW_SECRET=
